# --- PostgreSQL ---
POSTGRES_DB=join
POSTGRES_USER=join
POSTGRES_PASSWORD=change-me-strong-password

# --- FastAPI ---
# WAJIB diisi — tidak ada default di kode (sengaja, lihat docs/adr).
# Generate dengan: openssl rand -hex 32
SECRET_KEY=
SEED_ADMIN_EMAIL=admin@join.co.id
# WAJIB diisi — seed.py akan gagal kalau kosong, dengan sengaja (tidak ada
# password default yang bisa ditebak).
SEED_ADMIN_PASSWORD=
ENVIRONMENT=production

# --- Notifikasi email lead baru (opsional) ---
# Kosongkan SMTP_HOST kalau belum mau pakai fitur ini — form kontak tetap
# berfungsi normal (lead tetap tersimpan), hanya email notifikasinya yang
# dilewati. Kalau JOIN pakai Google Workspace: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USER=alamat pengirim, SMTP_PASSWORD=App Password
# (buat di myaccount.google.com/apppasswords, bukan password akun biasa).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JOIN Website <noreply@join.co.id>
NOTIFY_EMAIL_TO=corporate@join.co.id

# --- Cloudflare Tunnel ---
# Buat tunnel di dashboard Cloudflare Zero Trust > Networks > Tunnels,
# arahkan hostname join.co.id, www.join.co.id, api.join.co.id ke http://caddy:80
# lalu isi token di sini.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Next.js (build-time, dipakai di browser) ---
NEXT_PUBLIC_API_URL=https://api.join.co.id
# Nomor WhatsApp bisnis dgn kode negara, tanpa "+" atau spasi (mis. 6281234567890).
# Kosongkan untuk menyembunyikan tombol WhatsApp mengambang.
NEXT_PUBLIC_WHATSAPP_NUMBER=
