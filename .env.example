# --- PostgreSQL ---
POSTGRES_DB=join
POSTGRES_USER=join
POSTGRES_PASSWORD=change-me-strong-password

# --- FastAPI ---
# WAJIB diisi — tidak ada default di kode (sengaja, lihat docs/adr).
# Generate dengan: openssl rand -hex 32
SECRET_KEY=
SEED_ADMIN_EMAIL=admin@join.co.id
# WAJIB diisi — seed.py akan gagal kalau kosong, dengan sengaja (tidak ada
# password default yang bisa ditebak).
SEED_ADMIN_PASSWORD=
ENVIRONMENT=production

# --- Cloudflare Tunnel ---
# Buat tunnel di dashboard Cloudflare Zero Trust > Networks > Tunnels,
# arahkan hostname join.co.id, www.join.co.id, api.join.co.id ke http://caddy:80
# lalu isi token di sini.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Next.js (build-time, dipakai di browser) ---
NEXT_PUBLIC_API_URL=https://api.join.co.id
